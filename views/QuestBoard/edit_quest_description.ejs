<%- include("header", {title: title}); %>

<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="/style/header2.css">
    <link rel="stylesheet" href="/style/edit_quest2.css">
    <link rel="stylesheet" href="/style/footer.css">
</head>

<h1>Edit quest's Description: </h1>

<div class="edit-section"></div> 
    <form method="post" action="/QuestBoard/edit_quest_description" autocomplete="off">
        <input type="hidden" name="quest_id" value="<%= quest_id %>">
        <label for="quest_description">Description</label>
        <input type="text" id="quest_description" name="quest_description" required autocomplete="off"><br>
        <button type="submit" class="button">Edit</button>
    </form>
</div>

<%- include("footer"); %>