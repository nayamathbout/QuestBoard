<%- include("header", {title: title}); %>

<h1>Welcome to QuestBoard</h1>

<p>What do you wanna do today?</p>

<ul><li><a href="quest">Create a quest</a></li></ul>
<ul><li><a href="profile">View Profile</a></li></ul>

<p>Your Rewards:</p>
<table border="1">
<tr>
    <th>Coins:</th><td><%= rewards?.coins %></td>
</tr>
<tr>
    <th>XP:</th><td><%= rewards?.xp %></td>
</tr>
<tr>
    <th>Level:</th><td><%= rewards?.user_level %></td>
</tr>
<tr>
    <th>XP left for next level:</th><td><%= rewards?.xp_left %></td>
</tr>
</table>

<p>Upcoming Quests:</p>
<table border="1">
    <tr>
        <th>Quest_name</th>
        <th>Description</th>
        <th>Type</th>
        <th>Due Date</th>
        <th>Due In</th>
        <th>Status</th>
    </tr>
<% for (const row of upcomingQuests) { %>
    <tr>
        <td><%= row.quest_name %></td>
        <td>
            <% if (!row.quest_description) { %>
                <ul><li><a href="add_description?quest_id=<%= row.quest_id %>">Add description</a></li></ul>
            <% } else { %>
                <%= row.quest_description %>
            <% } %>
        </td>
        <td><%= row.quest_type %></td>
        <td><%= row.due_time %></td>
        <td><%= row.due_in%></td>
        <td><%= row.quest_status %></td>
        <td>
            <ul><li><a href="delete_quest?quest_id=<%= row.quest_id %>">Delete</a></li></ul>
        </td>
        <td>
            <form method="post" action="/QuestBoard/dashboard">
                <input type="hidden" name="quest_id" value="<%= row.quest_id %>">
                <button type="submit">Complete!</button>
            </form>
        </td>
    </tr>
<% }; %>
</table>


<p>Daily Quests:</p>
<table border="1">
    <tr>
        <th>Quest name</th>
        <th>Description</th>
        <th>Status</th>
    </tr>
<% for (const row of dailyQuests) { %>
    <tr>
        <td><%= row.quest_name %></td>
        <td>
            <% if (!row.quest_description) { %>
                <ul><li><a href="add_description?quest_id=<%= row.quest_id %>">Add description</a></li></ul>
            <% } else { %>
                <%= row.quest_description %>
            <% } %></td>
        <td><%= row.quest_status %></td>
        <td>
            <ul><li><a href="delete_quest?quest_id=<%= row.quest_id %>">Delete</a></li></ul>
        </td>
    </tr>
<% }; %>
</table>

<%- include("footer"); %>