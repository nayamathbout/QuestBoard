<%- include("header2", {title: title}); %>


<head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="/style/login.css">
</head>

<h1>Welcome to QuestBoard</h1>


<form method="post" action="/QuestBoard/login" autocomplete="off">
    <h2>Log in</h2>
    <label for="email">Email</label>
    <input type="text" id="email" name="email" required autocomplete="off"><br>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required required autocomplete="new-password"><br>

    <button type="submit">Log In</button>
</form>

<p1>Don't have an account? <a href="signup" class="signup-link">Sign Up</a></p1>


<% if (error) { %>
    <div class="error"><%= error %></div>
<% } %>

<%- include("footer"); %>
