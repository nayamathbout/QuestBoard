<%- include("header", {title: title}); %>

<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="/style/header2.css">
    <link rel="stylesheet" href="/style/edit_quest.css">
    <link rel="stylesheet" href="/style/footer.css">
</head>

<h1>Edit selected quest:</h1>

<div class="editQuest"></div>
    <div class="card">
        <table class="table">
            <input type="hidden" name="quest_id" value="<%= selected_quest?.quest_id %>">
            <tr>
                <th>Quest name:</th><td><%= selected_quest?.quest_name %></td>
            </tr>
            <tr>
                <th>Description:</th><td><%= selected_quest?.quest_description %></td>
            </tr>
            <tr>
                <th>Type:</th><td><%= selected_quest?.quest_type %></td>
            </tr>
        </table>
    </div>
    <div class="actions">
        <a href="edit_quest_name?quest_id=<%= selected_quest.quest_id %>" class="link">Edit name</a>
        <a href="edit_quest_description?quest_id=<%= selected_quest.quest_id %>" class="link">Edit description</a>
        <a href="edit_quest_type?quest_id=<%= selected_quest.quest_id %>" class="link">Edit type</a>
    </div>
</div>

<%- include("footer"); %>
