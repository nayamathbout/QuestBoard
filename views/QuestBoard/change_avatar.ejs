<%- include("header", {title: title}); %>

<h1>Change your Avatar</h1>


<p>Owned avatars:</p>
<table border="1">
    <tr>
        <th>Item</th>
        <th>Item Name</th>
        <th>Description</th>
    </tr>
<% for (const row of ownedItems) { %>
    <tr>
        <td><img src="/style/img/avatars/<%= row.item_id %>.png" width="100"></td>
        <td><%= row.item_name %></td>
        </td>
        <td><%= row.item_description %></td>
        <td>
            <form method="post" action="/QuestBoard/change_avatar">
                <input type="hidden" name="item_id" value="<%= row.item_id %>">
                <button type="submit">Choose!</button>
            </form>
        </td>
    </tr>
<% }; %>
</table>

<%- include("footer"); %>