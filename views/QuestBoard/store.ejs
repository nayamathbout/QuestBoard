<%- include("header", {title: data.title}); %>

<h1>QuestBoard Store:</h1>

<p>Your Coins:</p>
<table border="1">
<tr>
    <th>Coins:</th><td><%= rewards?.coins %></td>
</tr>
</table>

<p>Shop avatars:</p>
<table border="1">
    <tr>
        <th>Item</th>
        <th>Item Name</th>
        <th>Cost</th>
        <th>Description</th>
    </tr>
<% for (const row of store) { %>
    <tr>
        <td><img src="/style/img/avatars/<%= row.item_id %>.png" width="100"></td>
        <td><%= row.item_name %></td>
        </td>
        <td><%= row.cost %></td>
        <td><%= row.item_description %></td>
        <td>
            <form method="post" action="/QuestBoard/store">
                <input type="hidden" name="item_id" value="<%= row.item_id %>">
                <button type="submit">Buy!</button>
            </form>
        </td>
    </tr>
<% }; %>
</table>

<% if (data.error) { %>
    <div class="error"><%= data.error %></div>
<% } %>

<%- include("footer"); %>