<%- include("header", {title: title}); %>


<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="/style/header.css">
    <link rel="stylesheet" href="/style/profile.css">
    <link rel="stylesheet" href="/style/footer.css">
</head>

<h1>Your Profile</h1>

<div class="myprofile">
    <main class="main">

        <div class="card">
            <p class="card-title">About you</p>
            <table class="table">
                <tr>
                    <th>Name:</th><td><%= profile?.user_name %></td>
                </tr>
                <tr>
                    <th>Age:</th>
                    <td>
                        <% if (!profile.user_birthday) { %>
                            <a href="add_birthday" class="link">Add your birthday</a>
                        <% } else { %>
                            <%= profile.user_birthday %>
                        <% } %>
                    </td>
                </tr>
                <tr>
                    <th>Email:</th><td><%= profile?.email %></td>
                </tr>
                <tr>
                    <th>Bio:</th><td><%= profile?.user_bio %></td>
                </tr>
            </table>
        </div>

        <div class="actions">
            <a href="update_bio" class="action-link">Update your Bio</a>
            <a href="change_avatar" class="action-link">Change your Avatar</a>
        </div>


        <div class="card">
            <p class="card-title">Completed Quests</p>
            <table class="table">
                <tr>
                    <th>Quest name</th>
                    <th>Quest Description</th>
                    <th>Type</th>
                    <th>Completed on</th>
                    <th></th><th></th><th></th>
                </tr>
                <% for (const row of completedQuests) { %>
                <tr>
                    <td><%= row.quest_name %></td>
                    <td>
                        <% if (!row.quest_description) { %>
                            <a href="add_description?quest_id=<%= row.quest_id %>" class="link">Add description</a>
                        <% } else { %>
                            <%= row.quest_description %>
                        <% } %>
                    </td>
                    <td><%= row.quest_type %></td>
                    <td><%= row.completed_time %></td>
                </tr>
                <% }; %>
            </table>
        </div>

        <div class="card">
            <p class="card-title">Owned Avatars</p>
            <table class="table">
                <tr>
                    <th>Item</th>
                    <th>Item Name</th>
                    <th>Description</th>
                </tr>
                <% for (const row of ownedItems) { %>
                <tr>
                    <td><img src="/style/img/avatars/<%= row.item_id %>.png"></td>
                    <td><%= row.item_name %></td>
                    <td><%= row.item_description %></td>
                </tr>
                <% }; %>
            </table>
        </div>
    </main>

    <aside class="sidebar">
        <div class="card profile">
            <img src="/style/img/avatars/<%= profile?.user_avatar %>.png">
        </div>

        <div class="card stats">
            <div class="stat">
                <div class="label">XP</div>
                <div class="pill"><%= rewards?.xp %></div>
            </div>
            <div class="stat">
                <div class="label">Coins</div>
                <div class="pill"><%= rewards?.coins %></div>
            </div>
            <div class="stat">
                <div class="label">Level</div>
                <div class="pill"><%= rewards?.user_level %></div>
            </div>
            <div class="stat">
                <div class="label">XP left to level up: </div>
                <div class="pill"><%= rewards?.xp_left %></div>
            </div>
        </div>

        <div class="card">
            <p class="card-title">Badges</p>
            <div class="badges">
                <% for (const row of badges) { %>
                    <% if (row.badge_name === '4 Quests Badge') { %>
                        <img src="/style/img/badgeone.png" alt="4 Quests Badge">
                    <% } else if (row.badge_name === '4 Daily Quests Badge') { %>
                        <img src="/style/img/badgetwo.png" alt="4 Daily Quests Badge">
                    <% } else if (row.badge_name === '4 Weekly Quest Badge') { %>
                        <img src="/style/img/badgethree.png" alt="4 Weekly Quest Badge">
                    <% } %>
                <% }; %>
            </div>
        </div>

        <div class="card">
            <p class="card-title">Streaks</p>
            <div class="streaks">
                <% for (const row of streaks) { %>
                    <div class="streak">
                        <% if (row.streak_name === 'Log in streak') { %>
                            <img src="/style/img/streakone.png" alt="Log in streak">
                        <% } else if (row.streak_name === 'Quest completion streak') { %>
                            <img src="/style/img/streaktwo.png" alt="Quest completion streak">
                        <% } %>
                        <span class="count"><%= row.streak_duration %></span>
                    </div>
                <% }; %>
            </div>
        </div>
    </aside>
</div>



<%- include("footer"); %>