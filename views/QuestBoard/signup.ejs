<%- include("header2", {title: title}); %>

<head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="/style/signup.css">
</head>


<h1>Create an account</h1>


<form method="post" action="/QuestBoard/signup" autocomplete="off">
    <label for="user_name">Name:</label>
    <input type="text" id="user_name" name="user_name" required autocomplete="off"><br>

    <label for="email">Email</label>
    <input type="text" id="email" name="email" required autocomplete="off"><br>

    <label for="password">Password</label>
    <div style="position: relative; display: inline-block;">
        <input type="password" id="password" name="password" required autocomplete="new-password">
        <button type="button" class="view-button" onclick="togglePassword()">
            View
        </button>
    </div><br>

    <button type="submit" class="signup-button">Create Account</button>
</form>

<p1>Email must be unique <br> & password must contain at least:</p1>
    <ul> 
        <li>one lowercase letter</li>
        <li>one uppercase letter</li>
        <li>one digit (? = . * /)</li>
        <li>8 characters</li>
    </ul>
</p1>

<% if (error) { %>
    <div class="error"><%= error %></div>
<% } %>

<script>
function togglePassword() {
    const pwd = document.getElementById("password");
    pwd.type = (pwd.type === "password") ? "text" : "password";
}
</script>

<%- include("footer"); %>